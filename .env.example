# Copy to .env and fill in. Never commit .env (NFR-9).

# Secrets — change these for anything beyond local development.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
CODE_HASH_SECRET=local-dev-code-secret-change-me

# First admin login (created on first start if no admin exists).
ADMIN_BOOTSTRAP_EMAIL=admin@plms.local
ADMIN_BOOTSTRAP_PASSWORD=admin12345

# Email via Resend (https://resend.com). With EMAIL_ENABLED=false, emails are only logged and
# the registration/sign-in screens show the 6-digit code so you can test without an account.
EMAIL_ENABLED=false
DEV_EXPOSE_CODES=true
RESEND_API_KEY=
# onboarding@resend.dev only delivers to your own Resend account address; use a verified domain otherwise.
EMAIL_FROM=PLMS <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Demo vehicles (delivered+...@resend.dev test inboxes) for the simulator.
SEED_DEMO=true
PUBLIC_URL=http://localhost:3000
